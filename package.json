{
  "name": "fightlab",
  "version": "0.1.0",
  "private": true,
  "description": "A seeded run-based autobattler: build two three-action bars, pack a mod grid, and choose when to mix up.",
  "type": "module",
  "scripts": {
    "predev": "node pipelines/pin.ts",
    "dev": "node pipelines/dev.ts",
    "prebuild": "node pipelines/pin.ts",
    "build": "vite build",
    "preview": "node pipelines/dev.ts preview",
    "check:boneyard": "node pipelines/pin.ts",
    "pin:boneyard": "node pipelines/pin.ts --update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tune": "node pipelines/tune.ts",
    "check": "npm run check:boneyard && npm run test:github-settings && npm run test:release-identity && npm run test:distribution-boundary && npm run test:production-deployment && npm run typecheck && npm test && vite build && npm run check:public-build",
    "check:public-build": "node pipelines/check-public-build.ts",
    "deploy:production:dry-run": "npm run build && wrangler deploy --env production --dry-run",
    "verify": "npm run check",
    "check:release-identity": "node pipelines/release-identity.ts",
    "verify:github-settings": "node pipelines/verify-github-settings.ts",
    "test:github-settings": "node --test pipelines/github-repository-settings-cases.ts",
    "apply:github-settings": "node pipelines/apply-github-settings.ts",
    "test:release-identity": "node --test pipelines/release-identity-cases.ts",
    "test:distribution-boundary": "node --test pipelines/distribution-boundary-cases.ts",
    "test:production-deployment": "node --test pipelines/production-deployment-cases.mjs",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "boneyard": "file:../Boneyard"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  }
}

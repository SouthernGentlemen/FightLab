{
  "name": "fightlab",
  "version": "0.1.0",
  "private": true,
  "description": "A seeded run-based autobattler: build two three-action bars, pack a mod grid, and choose when to mix up.",
  "type": "module",
  "scripts": {
    "predev": "node pipelines/pin.ts",
    "dev": "node pipelines/dev.ts",
    "prebuild": "node pipelines/pin.ts",
    "build": "vite build",
    "preview": "node pipelines/dev.ts preview",
    "check:boneyard": "node pipelines/pin.ts",
    "pin:boneyard": "node pipelines/pin.ts --update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tune": "node pipelines/tune.ts",
    "verify": "npm run check:boneyard && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "boneyard": "file:../Boneyard"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}

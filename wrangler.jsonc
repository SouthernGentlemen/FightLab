{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fightlab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "production": {
      "name": "fightlab",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "fightlab.wizardgang.ai", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none"
      }
    }
  }
}
